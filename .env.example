DATABASE_URL=postgresql://student:student@localhost:5432/auth_lab?schema=public
PORT=3000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_ISSUER=pr8-api
JWT_AUDIENCE=pr8-web
ACCESS_TTL_SECONDS=900
SESSION_TTL_SECONDS=604800
# Expired/revoked sessions are deleted after this retention period (default 7 days).
SESSION_RETENTION_SECONDS=604800
SESSION_CLEANUP_INTERVAL_SECONDS=3600
RATE_LIMIT_PER_MINUTE=30
# Host port for docker compose PostgreSQL (change if 5432 is busy, and update DATABASE_URL).
DB_PORT=5432
